# Copy this file to .env.local and fill in real values. Never commit .env.local.

# --- Database (Supabase Postgres) ---
# Only one of these connection-string vars is required; postgres.ts checks them in this order.
SUPABASE_DB_URL="postgresql://user:password@host:5432/postgres"
# DATABASE_URL=
# POSTGRES_URL=
# SUPABASE_CONNECTION_STRING=
# POSTGRES_CONNECTION_STRING=
DATABASE_NAME="postgres"
POSTGRES_SSL="true"
# SUPABASE_SSL="true"

# Supabase API keys (used by frontend-facing features that call Supabase directly, if any)
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""
SUPABASE_ANON_KEY=""

# --- Server ---
BACKEND_PORT=3001
# PORT=3001

# --- Auth ---
# Required in production. In non-production, falls back to an insecure dev default if unset.
JWT_SECRET="change-me-to-a-long-random-string"

# --- CORS ---
# Comma-separated list of allowed origins for production. In non-production, all origins are
# allowed regardless of this list unless you rely on it intentionally.
CORS_ORIGINS="http://localhost:3000"
# Set to "1" to bypass the CORS allow-list entirely (dangerous — do not set in production).
# ALLOW_ALL_CORS=

NODE_ENV="development"

# --- Email (optional) ---
# Leave unset in dev: emails are logged instead of sent. Set all four to enable real sending.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="UNYT Portal <no-reply@example.edu>"

# --- File storage (optional) ---
# Defaults to local disk under backend/uploads. Set STORAGE_DRIVER=s3 + the S3_* vars to use S3 instead.
# STORAGE_DRIVER=local
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=

# --- Error tracking (optional) ---
# Leave unset to disable. Set to enable Sentry error reporting.
# SENTRY_DSN=
