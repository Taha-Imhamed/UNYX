# Copy this file to .env.local and fill in real values. Never commit .env.local.

NEXT_PUBLIC_API_URL="http://localhost:3001/api"
BACKEND_URL="http://localhost:3001"
NEXT_PUBLIC_ANALYTICS="false"
NEXT_PUBLIC_APP_NAME="AR Company"
NEXT_PUBLIC_APP_DESCRIPTION="Course Management Administration Platform"

# --- Error tracking (optional) ---
# Leave unset to disable. Client-side (browser) errors only — server/edge Sentry for
# this Next.js app isn't wired up because @sentry/nextjs's Node instrumentation breaks
# the Windows Turbopack standalone build (a node:inspector chunk gets a colon in its
# filename, which Windows can't copy). The backend Express server has its own working
# Sentry setup (see backend/.env.example SENTRY_DSN) — most server errors are covered there.
# NEXT_PUBLIC_SENTRY_DSN=
